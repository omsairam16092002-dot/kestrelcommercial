# Copy to backend/.env and frontend/.env.local as needed.
# Never commit real secrets.

# --- Frontend (Vercel) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Backend (Railway / Render) ---
NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
MONGODB_URI=mongodb+srv://USER:PASS@cluster0.biswrsf.mongodb.net/kestrel?retryWrites=true&w=majority&appName=Cluster0
REDIS_URL=rediss://default:PASSWORD@UPSTASH_HOST:6379

# Cloudinary — signed uploads. Backend stores public_ids only.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=kestrel/listings

# Xero — STUB until app credentials arrive. Do not invent responses.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=http://localhost:4000/api/integrations/xero/callback
XERO_TENANT_ID=

# PEXA — STUB until app credentials arrive. Do not invent responses.
PEXA_CLIENT_ID=
PEXA_CLIENT_SECRET=
PEXA_REDIRECT_URI=http://localhost:4000/api/integrations/pexa/callback
PEXA_API_BASE=https://api.pexa.com.au

JWT_SECRET=
ADMIN_SEED_EMAIL=jignesh@kestrelcommercial.com
ADMIN_SEED_PASSWORD=
ADMIN_SIGNUP_OPEN=true
ADMIN_INVITE_CODE=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional internal auth for CRM write endpoints later
INTERNAL_API_KEY=

# Lead ping — email/WhatsApp the moment a form lands. Silent Mongo is a lost lead.
SITE_URL=http://localhost:3000
NOTIFY_EMAIL_TO=jignesh@kestrelcommercial.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Kestrel Commercial <jignesh@kestrelcommercial.com>
RESEND_API_KEY=
# Required in production to accept inbound portal enquiry webhooks. Unsigned payloads are rejected.
RESEND_WEBHOOK_SECRET=
LEAD_CAPTURE_EMAIL=leads@leads.kestrelcommercial.com
# Syndication — leave empty (not connected). Set to "pending" or a real provider key once signed up.
REALCOMMERCIAL_FEED_PROVIDER_KEY=
CRE_FEED_PROVIDER_KEY=
NOTIFY_WEBHOOK_URL=
NOTIFY_FORMSUBMIT=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
NOTIFY_WHATSAPP_TO=whatsapp:+61431000038
